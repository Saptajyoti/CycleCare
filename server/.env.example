# Keep the real key only in server/.env (which is ignored by Git).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated extra origins are allowed in addition to the production and localhost frontend origins.
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
GEMINI_TIMEOUT_MS=30000
